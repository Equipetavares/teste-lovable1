import { createFileRoute } from "@tanstack/react-router";
import { useServerFn } from "@tanstack/react-start";
import { useState, useEffect } from "react";
import {
  Download,
  Link as LinkIcon,
  AlertCircle,
  Copy,
  Loader2,
  Music,
  ShieldCheck,
  Zap,
  Smartphone,
  ShoppingBag,
  Heart,
  Share,
  Info,
  MonitorPlay,
  ExternalLink,
  CheckCircle,
  PlusSquare,
  X,
} from "lucide-react";
import { resolveTiktok, proxyDownload } from "@/lib/tiktok.functions";
import DownloadSource from "@/components/DownloadSource";

export const Route = createFileRoute("/")({
  head: () => ({
    meta: [
      { title: "Vídeos da Yasmin — Baixar TikTok sem marca d'água" },
      {
        name: "description",
        content:
          "Baixe vídeos do TikTok em Full HD sem marca d'água. Rápido, grátis e funciona no iPhone e Android.",
      },
      { property: "og:title", content: "Vídeos da Yasmin" },
      {
        property: "og:description",
        content: "Baixe vídeos do TikTok em Full HD sem marca d'água.",
      },
    ],
    links: [{ rel: "canonical", href: "/" }],
  }),
  component: App,
});

type ResultData = {
  author: string;
  desc: string;
  cover: string;
  videoUrl: string | null;
  hdVideoUrl: string | null;
  musicUrl: string | null;
};

const APP_ICON =
  "https://i.ibb.co/rRmq5whQ/Imagem-do-Whats-App-de-2025-10-20-s-21-54-56-f5086375.jpg";

function App() {
  const resolve = useServerFn(resolveTiktok);
  const proxy = useServerFn(proxyDownload);

  const [url, setUrl] = useState("");
  const [loading, setLoading] = useState(false);
  const [downloading, setDownloading] = useState(false);
  const [error, setError] = useState("");
  const [result, setResult] = useState<ResultData | null>(null);
  const [isIOS, setIsIOS] = useState(false);
  const [downloadSuccess, setDownloadSuccess] = useState(false);

  const [deferredPrompt, setDeferredPrompt] = useState<any>(null);
  const [showInstallButton, setShowInstallButton] = useState(false);
  const [showIOSInstructions, setShowIOSInstructions] = useState(false);

  useEffect(() => {
    const checkIsIOS =
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    setIsIOS(checkIsIOS);

    const manifest = {
      name: "Vídeos da Yasmin",
      short_name: "YasminApp",
      start_url: "/",
      display: "standalone",
      background_color: "#ffffff",
      theme_color: "#ee4d2d",
      icons: [
        { src: APP_ICON, sizes: "192x192", type: "image/jpeg" },
        { src: APP_ICON, sizes: "512x512", type: "image/jpeg" },
      ],
    };
    const blob = new Blob([JSON.stringify(manifest)], {
      type: "application/json",
    });
    const manifestURL = URL.createObjectURL(blob);

    const linkManifest = document.createElement("link");
    linkManifest.rel = "manifest";
    linkManifest.href = manifestURL;
    document.head.appendChild(linkManifest);

    const linkApple = document.createElement("link");
    linkApple.rel = "apple-touch-icon";
    linkApple.href = APP_ICON;
    document.head.appendChild(linkApple);

    const metaMobile = document.createElement("meta");
    metaMobile.name = "apple-mobile-web-app-capable";
    metaMobile.content = "yes";
    document.head.appendChild(metaMobile);

    const handleBeforeInstallPrompt = (e: any) => {
      e.preventDefault();
      setDeferredPrompt(e);
      setShowInstallButton(true);
    };
    window.addEventListener("beforeinstallprompt", handleBeforeInstallPrompt);

    if (window.matchMedia("(display-mode: standalone)").matches) {
      setShowInstallButton(false);
    } else if (checkIsIOS) {
      setShowInstallButton(true);
    }

    return () => {
      window.removeEventListener(
        "beforeinstallprompt",
        handleBeforeInstallPrompt,
      );
      URL.revokeObjectURL(manifestURL);
    };
  }, []);

  const handleInstallClick = async () => {
    if (isIOS) {
      setShowIOSInstructions(true);
    } else if (deferredPrompt) {
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      if (outcome === "accepted") {
        setDeferredPrompt(null);
        setShowInstallButton(false);
      }
    } else {
      alert(
        "Para instalar, use o menu do seu navegador e selecione 'Adicionar à tela inicial'.",
      );
    }
  };

  const handleDownload = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    setResult(null);
    setDownloadSuccess(false);

    if (!url.includes("tiktok.com")) {
      setError("Ops! Esse link não parece ser do TikTok.");
      return;
    }

    setLoading(true);
    try {
      const data = await resolve({ data: { url } });
      setResult(data);
    } catch (err) {
      console.error(err);
      setError("Não conseguimos baixar esse vídeo no momento. Tente novamente!");
    } finally {
      setLoading(false);
    }
  };

  const base64ToBlob = (b64: string, contentType: string) => {
    const byteChars = atob(b64);
    const byteNumbers = new Array(byteChars.length);
    for (let i = 0; i < byteChars.length; i++) {
      byteNumbers[i] = byteChars.charCodeAt(i);
    }
    return new Blob([new Uint8Array(byteNumbers)], { type: contentType });
  };

  const handleVideoAction = async (videoUrl: string, filename: string) => {
    if (isIOS) {
      window.open(videoUrl, "_blank");
      return;
    }
    try {
      setDownloading(true);
      setDownloadSuccess(false);

      const { base64, contentType } = await proxy({ data: { url: videoUrl } });
      const blob = base64ToBlob(base64, contentType);
      if (blob.size < 1000) throw new Error("Arquivo vazio");

      const blobUrl = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = blobUrl;
      link.download = filename || `yasmin_video_${Date.now()}.mp4`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(blobUrl);
      setDownloadSuccess(true);
    } catch (err) {
      console.warn("Download falhou:", err);
      window.open(videoUrl, "_blank");
      alert(
        "O navegador bloqueou o download automático. O vídeo foi aberto em uma nova aba: Clique nos 3 pontinhos e selecione 'Fazer Download'.",
      );
    } finally {
      setDownloading(false);
    }
  };

  const handlePaste = async () => {
    try {
      const text = await navigator.clipboard.readText();
      setUrl(text);
    } catch {
      document.getElementById("url-input")?.focus();
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 font-sans text-gray-800 flex flex-col">
      <header className="bg-white shadow-sm sticky top-0 z-40 border-b-2 border-orange-100">
        <div className="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <img
              src={APP_ICON}
              alt="Icon"
              className="w-8 h-8 rounded-lg shadow-sm border border-orange-200"
            />
            <span className="text-xl font-bold text-[#ee4d2d] tracking-tight hidden md:block">
              Vídeos da Yasmin
            </span>
            <span className="text-lg font-bold text-[#ee4d2d] tracking-tight md:hidden">
              YasminApp
            </span>
          </div>
          <div className="flex items-center gap-3">
            <nav className="hidden md:flex gap-6 text-sm font-medium text-gray-500 mr-4">
              <a href="#inicio" className="hover:text-[#ee4d2d]">Início</a>
              <a href="#como-usar" className="hover:text-[#ee4d2d]">Como Baixar</a>
            </nav>
            {showInstallButton && (
              <button
                onClick={handleInstallClick}
                className="bg-black text-white text-xs font-bold px-3 py-2 rounded-full flex items-center gap-2 shadow-lg hover:bg-gray-800 animate-pulse"
              >
                <Download size={14} />
                INSTALAR APP
              </button>
            )}
          </div>
        </div>
      </header>

      {showIOSInstructions && (
        <div className="fixed inset-0 z-50 bg-black/80 flex items-end md:items-center justify-center p-4 backdrop-blur-sm">
          <div className="bg-white w-full max-w-md rounded-2xl p-6 relative shadow-2xl">
            <button
              onClick={() => setShowIOSInstructions(false)}
              className="absolute top-4 right-4 text-gray-400 hover:text-gray-600"
            >
              <X size={24} />
            </button>
            <div className="flex flex-col items-center text-center">
              <img src={APP_ICON} alt="App Icon" className="w-20 h-20 rounded-xl shadow-lg mb-4" />
              <h3 className="text-xl font-bold text-gray-900 mb-2">Instalar YasminApp</h3>
              <p className="text-gray-600 text-sm mb-6">
                Instale este aplicativo no seu iPhone para acesso rápido e fácil.
              </p>
              <div className="w-full space-y-4 text-left bg-gray-50 p-4 rounded-xl border border-gray-100">
                <div className="flex items-center gap-3">
                  <div className="bg-gray-200 p-2 rounded text-blue-600"><Share size={20} /></div>
                  <span className="text-sm text-gray-700">1. Toque no botão <strong>Compartilhar</strong> abaixo.</span>
                </div>
                <div className="h-px bg-gray-200 w-full"></div>
                <div className="flex items-center gap-3">
                  <div className="bg-gray-200 p-2 rounded text-gray-600"><PlusSquare size={20} /></div>
                  <span className="text-sm text-gray-700">2. Selecione <strong>Adicionar à Tela de Início</strong>.</span>
                </div>
              </div>
              <button
                onClick={() => setShowIOSInstructions(false)}
                className="mt-6 text-[#ee4d2d] font-bold text-sm hover:underline"
              >
                Entendi, fechar
              </button>
            </div>
          </div>
        </div>
      )}

      <section id="inicio" className="relative bg-gradient-to-br from-[#ee4d2d] via-[#ff7337] to-[#ff9068] text-white py-24 px-4 overflow-hidden">
        <div className="absolute top-0 left-0 w-full h-full overflow-hidden opacity-10 pointer-events-none">
          <div className="absolute top-10 left-10 rotate-12"><ShoppingBag size={100} /></div>
          <div className="absolute bottom-10 right-10 -rotate-12"><Heart size={120} /></div>
        </div>
        <div className="max-w-3xl mx-auto text-center space-y-8 relative z-10">
          <div className="inline-block bg-white/20 backdrop-blur-md px-4 py-1 rounded-full text-sm font-medium border border-white/30 shadow-lg">
            ✨ Baixe seus achadinhos do TikTok
          </div>
          <h1 className="text-4xl md:text-6xl font-extrabold tracking-tight drop-shadow-sm">
            Salve vídeos <br />
            <span className="text-yellow-200">Sem Marca d'Água!</span>
          </h1>
          <p className="text-lg md:text-xl text-orange-50 font-medium max-w-2xl mx-auto">
            Cole o link abaixo e baixe em <strong>Full HD (1080p)</strong> para sua galeria.
          </p>

          <div className="bg-white p-2 rounded-lg shadow-2xl max-w-2xl mx-auto border-4 border-orange-300/30">
            <form onSubmit={handleDownload} className="flex flex-col md:flex-row gap-2">
              <div className="relative flex-grow">
                <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                  <LinkIcon size={18} />
                </div>
                <input
                  id="url-input"
                  type="text"
                  value={url}
                  onChange={(e) => setUrl(e.target.value)}
                  placeholder="Cole o link do TikTok aqui..."
                  className="w-full pl-11 pr-4 py-4 rounded md:rounded-l text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#ee4d2d] bg-gray-50 border-transparent"
                />
                {url === "" && (
                  <button
                    type="button"
                    onClick={handlePaste}
                    className="absolute inset-y-0 right-2 my-auto px-3 py-1 text-xs font-bold text-[#ee4d2d] bg-orange-100 hover:bg-orange-200 rounded md:flex items-center gap-1 hidden uppercase tracking-wide"
                  >
                    <Copy size={12} /> Colar Link
                  </button>
                )}
              </div>
              <button
                type="submit"
                disabled={loading || !url}
                className={`px-8 py-4 rounded font-bold text-white shadow-lg transition-all flex items-center justify-center gap-2 uppercase tracking-wide min-w-[140px] ${
                  loading || !url
                    ? "bg-gray-300 cursor-not-allowed"
                    : "bg-[#ee4d2d] hover:bg-[#d03e1f] hover:shadow-orange-500/30 active:translate-y-0.5"
                }`}
              >
                {loading ? <Loader2 className="animate-spin" size={20} /> : "BAIXAR"}
              </button>
            </form>
          </div>

          {error && (
            <div className="bg-white text-[#ee4d2d] px-6 py-4 rounded-lg shadow-lg inline-flex items-start gap-3 font-medium text-left border-l-4 border-[#ee4d2d] max-w-2xl">
              <AlertCircle size={24} className="flex-shrink-0 mt-0.5" />
              <div>{error}</div>
            </div>
          )}
        </div>
        <div className="absolute bottom-0 left-0 w-full text-gray-50 leading-none">
          <svg className="relative block w-full h-12 md:h-24" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="currentColor" />
          </svg>
        </div>
      </section>

      {result && (
        <section className="max-w-4xl mx-auto px-4 -mt-8 relative z-20 mb-12">
          <div className="bg-white rounded-lg shadow-2xl overflow-hidden border border-orange-100">
            <div className="bg-orange-50 p-3 text-center text-[#ee4d2d] text-sm font-bold uppercase tracking-wider border-b border-orange-100">
              🎉 Vídeo Encontrado com Sucesso!
            </div>
            <div className="p-6 md:p-8 flex flex-col md:flex-row gap-8 items-start">
              <div className="w-full md:w-1/3 relative group">
                <div className="absolute -inset-1 bg-gradient-to-r from-[#ee4d2d] to-yellow-400 rounded-lg blur opacity-25 group-hover:opacity-50 transition duration-1000"></div>
                <img
                  src={result.cover}
                  alt="Cover"
                  className="relative w-full aspect-[9/16] object-cover rounded-lg shadow-md bg-gray-200 border-2 border-white"
                />
              </div>
              <div className="w-full md:w-2/3 flex flex-col gap-5">
                <div>
                  <div className="flex items-center gap-2 mb-2">
                    <div className="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-lg">👤</div>
                    <h3 className="text-xl font-bold text-gray-800">{result.author}</h3>
                  </div>
                  <p className="text-gray-600 text-sm line-clamp-3 bg-gray-50 p-3 rounded border border-gray-100">
                    {result.desc}
                  </p>
                </div>

                <div className="bg-blue-50 border border-blue-200 rounded-lg p-4 flex items-start gap-3">
                  <Info className="text-blue-600 flex-shrink-0 mt-1" size={20} />
                  <div className="text-sm text-blue-800">
                    <strong>Dica:</strong> Se o download falhar, o vídeo abrirá em nova aba. Clique nos 3 pontinhos e selecione <strong>Fazer Download</strong>.
                  </div>
                </div>

                {downloadSuccess && (
                  <div className="bg-green-50 text-green-700 p-3 rounded flex items-center gap-2 font-bold">
                    <CheckCircle size={20} /> Download Iniciado!
                  </div>
                )}

                <div className="space-y-3">
                  {result.hdVideoUrl && (
                    <button
                      onClick={() => handleVideoAction(result.hdVideoUrl!, `yasmin_video_1080p_${Date.now()}.mp4`)}
                      disabled={downloading}
                      className={`flex items-center justify-between w-full bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-white px-6 py-4 rounded shadow-lg transition-all transform hover:-translate-y-1 border border-orange-400 ${downloading ? "opacity-75 cursor-wait" : ""}`}
                    >
                      <div className="flex flex-col text-left">
                        <span className="font-extrabold text-lg flex items-center gap-2">
                          {downloading ? "PROCESSANDO..." : "BAIXAR FULL HD"}
                          <span className="bg-white text-[#ee4d2d] text-[10px] px-1.5 py-0.5 rounded font-black">HD</span>
                        </span>
                        <span className="text-orange-100 text-xs">Máxima resolução • Sem marca d'água</span>
                      </div>
                      <div className="bg-white/20 p-2 rounded-full">
                        {downloading ? <Loader2 className="animate-spin" /> : <MonitorPlay size={24} />}
                      </div>
                    </button>
                  )}

                  {result.videoUrl && (
                    <button
                      onClick={() => handleVideoAction(result.videoUrl!, `yasmin_video_${Date.now()}.mp4`)}
                      disabled={downloading}
                      className={`flex items-center justify-between w-full bg-white border-2 border-[#ee4d2d] text-[#ee4d2d] hover:bg-orange-50 px-6 py-3.5 rounded shadow-sm transition-all ${downloading ? "opacity-75 cursor-wait" : ""}`}
                    >
                      <div className="flex flex-col text-left">
                        <span className="font-bold text-lg">
                          {downloading ? "PROCESSANDO..." : "BAIXAR VÍDEO"}
                        </span>
                        <span className="text-gray-500 text-xs">
                          {result.hdVideoUrl ? "Resolução padrão (Leve)" : "Sem marca d'água • MP4"}
                        </span>
                      </div>
                      <div className="bg-orange-100 p-2 rounded-full">
                        {downloading ? <Loader2 className="animate-spin text-[#ee4d2d]" /> : <Download size={24} className="text-[#ee4d2d]" />}
                      </div>
                    </button>
                  )}

                  <a
                    href={result.hdVideoUrl || result.videoUrl || "#"}
                    target="_blank"
                    rel="noreferrer"
                    className="flex items-center justify-center w-full text-xs text-gray-400 hover:text-[#ee4d2d] mt-2"
                  >
                    <ExternalLink size={12} className="mr-1" />
                    Download não funcionou? Clique aqui para abrir direto
                  </a>

                  {result.musicUrl && (
                    <a
                      href={result.musicUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="flex items-center justify-between w-full bg-white border-2 border-gray-200 hover:border-gray-400 text-gray-600 hover:text-gray-800 px-6 py-3 rounded transition-all group"
                    >
                      <span className="flex items-center gap-2 font-semibold">
                        <Music size={20} />
                        Baixar Áudio (MP3)
                      </span>
                      <Download size={18} className="opacity-50 group-hover:opacity-100" />
                    </a>
                  )}
                </div>

                <div className="bg-green-50 text-green-700 text-xs p-2 rounded text-center border border-green-100 flex items-center justify-center gap-1">
                  <ShieldCheck size={12} /> Download Seguro
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      <section className="py-16 px-4 max-w-5xl mx-auto">
        <div className="grid md:grid-cols-3 gap-6">
          <FeatureCard icon={<Zap className="text-[#ee4d2d]" size={28} />} title="Entrega Rápida" desc="Processamento instantâneo do seu vídeo." />
          <FeatureCard icon={<ShoppingBag className="text-[#ee4d2d]" size={28} />} title="Qualidade Full HD" desc="Baixe em 1080p sempre que disponível." />
          <FeatureCard icon={<Smartphone className="text-[#ee4d2d]" size={28} />} title="Funciona no iPhone" desc="Adaptado para iOS. Salve direto na galeria." />
        </div>
      </section>

      <footer className="bg-white text-gray-500 py-8 px-4 border-t border-gray-200 mt-auto">
        <div className="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
          <div className="flex items-center gap-2">
            <span className="font-bold text-[#ee4d2d]">Vídeos da Yasmin</span>
            <span>© 2024</span>
          </div>
          <DownloadSource />
        </div>
      </footer>
    </div>
  );
}

function FeatureCard({
  icon,
  title,
  desc,
}: {
  icon: React.ReactNode;
  title: string;
  desc: string;
}) {
  return (
    <div className="bg-white p-6 rounded border border-gray-100 hover:border-orange-200 shadow-sm hover:shadow-lg transition-all flex flex-col items-center text-center group">
      <div className="mb-4 bg-orange-50 p-4 rounded-full group-hover:scale-110 transition-transform border border-orange-100">
        {icon}
      </div>
      <h3 className="text-lg font-bold mb-2 text-gray-800">{title}</h3>
      <p className="text-gray-500 text-sm leading-relaxed">{desc}</p>
    </div>
  );
}
